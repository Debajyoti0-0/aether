# Build the dashboard's WebAssembly modules.
#
# # Why this exists
#
# `go build` embeds internal/web/wasm/*.wasm and internal/web/static/verify.js
# with go:embed, so a plain `go build ./...` works from a clean checkout with no
# Rust toolchain. That is deliberate: the product is one Go binary, and making
# every contributor install Rust to build it would be a real cost for two small
# modules.
#
# The cost of that choice is that the compiled artifacts are committed. They are
# therefore generated by exactly one command, here, and re-running it must be
# the only way they change. `make wasm-check` proves a committed artifact matches
# what the current Rust source produces, which is what stops the two from drifting
# apart silently.
#
# Requirements: rustup target add wasm32-unknown-unknown, and wasm-pack.
#
#   make wasm          rebuild both modules
#   make wasm-test     run the Rust unit tests and the Node ABI smoke test
#   make wasm-check    fail if a committed artifact is stale
#   make wasm-clean    remove Rust build output

WASM_DIR   := internal/web/wasm
GRAPH_DIR  := $(WASM_DIR)/graph
VERIFY_DIR := $(WASM_DIR)/verify
CARGO      ?= cargo
WASM_PACK  ?= wasm-pack
NODE       ?= node

# wasm-opt is disabled deliberately. The binary wasm-pack downloads does not
# enable the bulk-memory proposal that Rust's standard library now emits, so
# enabling it fails the build on a validator error. The Rust release profile
# already sets opt-level, lto, codegen-units=1 and strip, so the lost pass costs
# size, not correctness.
WASM_PACK_FLAGS := --target web --release --no-opt

GRAPH_WASM  := $(WASM_DIR)/graph.wasm
VERIFY_WASM := $(WASM_DIR)/verify.wasm
VERIFY_JS   := internal/web/static/verify.js

.PHONY: wasm wasm-test wasm-check wasm-clean

wasm: $(GRAPH_WASM) $(VERIFY_WASM) $(VERIFY_JS)

# The graph module is a plain cdylib behind a hand-written C ABI, so cargo alone
# produces the final artifact and no glue file is involved.
$(GRAPH_WASM): $(GRAPH_DIR)/src/lib.rs $(GRAPH_DIR)/src/quadtree.rs $(GRAPH_DIR)/Cargo.toml
	cd $(GRAPH_DIR) && $(CARGO) build --target wasm32-unknown-unknown --release
	cp $(GRAPH_DIR)/target/wasm32-unknown-unknown/release/aether_graph.wasm $@

# The verifier uses wasm-bindgen, so the JS glue and the module are a matched
# pair and are always refreshed together. The module is the real target and the
# glue is derived from it, so a rebuild happens once rather than once per output.
$(VERIFY_WASM): $(VERIFY_DIR)/src/lib.rs $(VERIFY_DIR)/Cargo.toml
	cd $(VERIFY_DIR) && $(WASM_PACK) build $(WASM_PACK_FLAGS) --out-dir pkg
	cp $(VERIFY_DIR)/pkg/aether_verify_bg.wasm $(VERIFY_WASM)

$(VERIFY_JS): $(VERIFY_WASM) $(VERIFY_DIR)/src/lib.rs
	cp $(VERIFY_DIR)/pkg/aether_verify.js $@

wasm-test:
	cd $(GRAPH_DIR) && $(CARGO) test
	cd $(VERIFY_DIR) && $(CARGO) test
	$(NODE) $(WASM_DIR)/smoke-test.mjs

wasm-check:
	@echo "Rebuilding every WASM artifact from source and comparing..."
	@$(MAKE) --no-print-directory wasm
	@if command -v git >/dev/null 2>&1; then \
		if ! git diff --quiet -- $(GRAPH_WASM) $(VERIFY_WASM) $(VERIFY_JS); then \
			echo "FAIL: committed WASM artifacts are stale. Run 'make wasm' and commit the result."; \
			git diff --stat -- $(GRAPH_WASM) $(VERIFY_WASM) $(VERIFY_JS); \
			exit 1; \
		fi; \
		echo "ok: committed WASM artifacts match the Rust sources"; \
	else \
		echo "skipped: git not available, cannot compare"; \
	fi

wasm-clean:
	cd $(GRAPH_DIR) && $(CARGO) clean
	cd $(VERIFY_DIR) && $(CARGO) clean
	rm -rf $(VERIFY_DIR)/pkg
