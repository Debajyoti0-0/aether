{
  "samba4_harness": {
    "docker_compose": "scripts/ad-lab/docker-compose.yml",
    "container_name": "aether-ad-lab",
    "image": "aether-samba-ad-dc:latest",
    "hostname": "dc01",
    "domainname": "aether.test",
    "ports": {
      "53/tcp": "DNS",
      "53/udp": "DNS",
      "88/tcp": "Kerberos KDC",
      "88/udp": "Kerberos KDC",
      "135/tcp": "RPC",
      "139/tcp": "NetBIOS",
      "389/tcp": "LDAP",
      "389/udp": "LDAP",
      "445/tcp": "SMB (mapped to 4445)",
      "464/tcp": "kpasswd",
      "464/udp": "kpasswd",
      "636/tcp": "LDAPS",
      "3268/tcp": "Global Catalog",
      "3269/tcp": "Global Catalog SSL"
    },
    "environment": {
      "SAMBA_DOMAIN": "AETHER",
      "SAMBA_REALM": "AETHER.TEST",
      "ADMIN_PASSWORD": "Passw0rd123!",
      "KERBEROS_ENCRYPTION_TYPES": "aes256-cts-hmac-sha1-96,aes128-cts-hmac-sha1-96,rc4-hmac",
      "DNS_FORWARDER": "1.1.1.1"
    },
    "volumes": {
      "samba_data": "/var/lib/samba",
      "samba_etc": "/etc/samba"
    },
    "healthcheck": "samba-tool domain info 127.0.0.1",
    "startup_scripts": [
      "scripts/ad-lab/start.sh",
      "scripts/ad-lab/provision.sh",
      "scripts/ad-lab/entrypoint.sh"
    ],
    "seed_script": "scripts/ad-lab/seed.sh"
  },
  "seeded_identities": {
    "users": [
      { "name": "user1", "password": "Passw0rd123!", "description": "Normal user for Kerberos authentication" },
      { "name": "user2", "password": "Passw0rd123!", "description": "AS-REP roastable (DONT_REQ_PREAUTH flag set)" },
      { "name": "user3", "password": "Passw0rd123!", "description": "Domain Admin" },
      { "name": "user4", "password": "Passw0rd123!", "description": "ACL target (user1 has GenericAll)" },
      { "name": "svc_sql", "password": "SvcPass123!", "description": "Service account for MSSQL", "spn": "MSSQLSvc/sql01.aether.test:1433" },
      { "name": "svc_web", "password": "WebPass123!", "description": "Service account for HTTP", "spn": "HTTP/web01.aether.test" }
    ],
    "groups": [
      { "name": "Tier1-Admins", "description": "Tier 1 Administrators", "members": ["user3"], "nested_in": "Domain Admins" },
      { "name": "Tier2-Admins", "description": "Tier 2 Administrators", "members": ["user2"] }
    ],
    "acls": [
      { "principal": "user1", "target": "user4", "rights": "GenericAll" },
      { "principal": "user2", "target": "user1", "rights": "WriteDACL" }
    ],
    "spns": [
      "MSSQLSvc/sql01.aether.test:1433 -> svc_sql",
      "HTTP/web01.aether.test -> svc_web"
    ]
  },
  "lab_management": {
    "start": "bash scripts/ad-lab/start.sh",
    "stop": "bash scripts/ad-lab/stop.sh",
    "seed": "bash scripts/ad-lab/seed.sh",
    "health_check": "docker exec aether-ad-lab samba-tool domain info 127.0.0.1",
    "ldap_check": "ldapsearch -x -H ldap://localhost:389 -b \"DC=aether,DC=test\" -s base"
  }
}